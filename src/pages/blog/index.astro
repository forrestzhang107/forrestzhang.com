---
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate, isoDate } from "../../data/blog";

const posts = await getPosts();
---
<Base title="Writing" description="Writing by Forrest Zhang.">
  <section>
    <div class="label">Writing</div>
    {posts.length === 0 ? (
      <p class="muted">Nothing yet.</p>
    ) : (
      posts.map((post) => (
        <a class="row post" href={`/blog/${post.id}/`}>
          <span>{post.data.title}</span>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        </a>
      ))
    )}
  </section>
</Base>
