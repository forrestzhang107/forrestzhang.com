---
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate, isoDate } from "../../data/blog";

const posts = await getPosts();
---
<Base title="Writing" description="Writing by Forrest Zhang on AI agents, agent memory and the companies he builds." card="blog">
  <section class="first">
    <div class="label">Writing</div>
    {posts.length === 0 ? (
      <p class="muted">Nothing yet.</p>
    ) : (
      <div class="rows">
        {posts.map((post) => (
          <a class="row" href={`/blog/${post.id}/`}>
            <div class="l"><span class="t">{post.data.title}</span></div>
            <time class="r" datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          </a>
        ))}
      </div>
    )}
  </section>
</Base>
