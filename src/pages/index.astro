---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { SITE, PROJECTS, BIO } from "../data/site";
import { getPosts, formatDate, isoDate } from "../data/blog";

const posts = (await getPosts()).slice(0, 5);

// Split the bio into text and {Project} links.
const urls = Object.fromEntries(PROJECTS.map((p) => [p.name, p.url]));
const bio = BIO.split(/(\{[^}]+\})/).filter(Boolean).map((part) => {
  const m = part.match(/^\{(.+)\}$/);
  return m ? { text: m[1], url: urls[m[1]] } : { text: part };
});
---
<Base>
  <header class="intro">
    <img class="avatar" src="/forrest.jpg" alt="Forrest Zhang" width="44" height="44" />
    <div>
      <h1>{SITE.name}</h1>
      <div class="muted">{SITE.location}</div>
    </div>
  </header>

  <p class="bio">
    {bio.map((b) => (b.url ? <a href={b.url}>{b.text}</a> : b.text))}
  </p>

  <section>
    <div class="label">Projects</div>
    <div class="rows">
      {PROJECTS.map((p) => {
        const inner = (
          <Fragment>
            <div class="l">
              <span class="t">{p.name}{p.url && <Arrow />}</span>
              <p>{p.summary}</p>
            </div>
            <span class="r">{p.role}</span>
          </Fragment>
        );
        return p.url ? <a class="row" href={p.url}>{inner}</a> : <div class="row">{inner}</div>;
      })}
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="label">Writing</div>
      <div class="rows">
        {posts.map((post) => (
          <a class="row" href={`/blog/${post.id}/`}>
            <div class="l"><span class="t">{post.data.title}</span></div>
            <time class="r" datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
