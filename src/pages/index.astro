---
import Base from "../layouts/Base.astro";
import { SITE, PROJECTS, LINKS } from "../data/site";
import { getPosts, formatDate, isoDate } from "../data/blog";

const posts = (await getPosts()).slice(0, 5);
---
<Base>
  <header class="intro">
    <img class="avatar" src="/forrest.jpg" alt="Forrest Zhang" width="64" height="64" />
    <h1>{SITE.name}</h1>
    <div class="muted">{SITE.tagline}</div>
  </header>

  <section>
    <div class="label">Projects</div>
    {PROJECTS.map((p) => {
      const cells = (
        <Fragment>
          <span>{p.name}</span>
          <span class="muted r">{p.role}</span>
          <span class="d">{p.summary}</span>
          <span class="go">{p.url && (
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4" fill="none" stroke="currentColor" stroke-width="1.1" />
            </svg>
          )}</span>
        </Fragment>
      );
      return p.url ? <a class="row" href={p.url}>{cells}</a> : <div class="row">{cells}</div>;
    })}
  </section>

  {posts.length > 0 && (
    <section>
      <div class="label">Writing</div>
      {posts.map((post) => (
        <a class="row post" href={`/blog/${post.id}/`}>
          <span>{post.data.title}</span>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        </a>
      ))}
    </section>
  )}

  <section>
    <div class="label">Elsewhere</div>
    <div class="links">
      {LINKS.map((l) => <a href={l.url} rel="me">{l.label}</a>)}
    </div>
  </section>
</Base>
